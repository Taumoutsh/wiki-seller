# Copier ce fichier en .env puis renseigner les identifiants (le .env n'est jamais commité).
MAIL=
PASSWORD=

# Session copiée depuis un navigateur connecté, pour éviter la vérification Cloudflare
# de la page de connexion (voir README, « Première connexion »). Le plus simple :
# ./update_session.sh, qui réécrit cette ligne. Format : sb-...-auth-token.0=base64-...;sb-...-auth-token.1=...
SESSION_COOKIES=

# Ouverture automatique des paquets, heures de Paris [début-fin[ ; vide = jamais.
OPEN_PACKS_HOURS=0-6

# Achats (wanted_cards.json) : budget total optionnel des mises en cours, en wikibidous,
# et nombre de secondes avant la fin d'une enchère pour surenchérir (5 à 300).
# MAX_TOTAL_BIDS=
# SNIPE_LEAD=20

# Journal des appels à l'API du site dans state/api.log (sans cookies) : 1 pour l'activer.
# API_TRACE=

# Ressources maximales du conteneur (docker compose).
# CPU_LIMIT=2
# MEM_LIMIT=2g

# Raretés mises en vente (L, UR, SR, R, PC, C), séparées par des virgules. Vide = toutes.
SELL_RARITIES=L,SR

# Optionnel
# BASE_URL=https://www.wiki-masters.com
# SAFE_CARDS_FILE=safed_cards.json
# STATE_DIR=state
# PRICE_RATIO=0.70
# Durée des enchères, libellé exact d'un bouton du site : 10 min, 30 min, 1 h, 3 h, 6 h, 12 h
# AUCTION_DURATION_LABEL=1 h
# Délai avant la passe suivante (ex. 10 min, 1 h, 1h30 ; 5 min minimum).
# Vide = la durée des enchères ci-dessus.
# RUN_INTERVAL=
# HEADLESS=true
# Chemin d'un Chromium déjà installé (inutile dans l'image Docker)
# CHROMIUM_EXECUTABLE=
