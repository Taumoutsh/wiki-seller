# Copier ce fichier en .env puis renseigner les identifiants (le .env n'est jamais commité).
MAIL=
PASSWORD=

# Session copiée depuis un navigateur connecté, pour éviter la vérification Cloudflare
# de la page de connexion (voir README, « Première connexion »). Le plus simple :
# ./update_session.sh, qui réécrit cette ligne. Format : sb-...-auth-token.0=base64-...;sb-...-auth-token.1=...
SESSION_COOKIES=

# Durée des ventes la nuit, heures de Paris [début-fin[=libellé d'un bouton du site ;
# vide = AUCTION_DURATION_LABEL toute la journée.
NIGHT_DURATIONS=1-3=12 h;3-6=6 h

# Ouverture automatique des paquets, heures de Paris [début-fin[ (ex. 0-6) ; vide = jamais.
# Désactivée : le site exige désormais une vérification humaine, ouvrez-les à la main.
OPEN_PACKS_HOURS=
# Vérification humaine demandée pour les paquets : minutes d'attente qu'une PERSONNE la
# fasse dans le navigateur (exige HEADLESS=false + écran distant) ; vide = pause de 12 h.
# NOTIFY_URL : notification ntfy pour la prévenir (ex. https://ntfy.sh/mon-sujet).
PACKS_VERIFY_WAIT=
NOTIFY_URL=

# Achats (wanted_cards.json) : budget total optionnel des mises en cours, en wikibidous,
# et nombre de secondes avant la fin d'une enchère pour surenchérir (2 à 300 ; l'enchère
# est surveillée chaque seconde pendant sa dernière minute).
# MAX_TOTAL_BIDS=
# SNIPE_LEAD=5

# Actions (ouvrir les paquets, mettre en vente, miser) : « api » = requêtes directes à
# l'API du site (par défaut, plus rapide et plus fiable), « page » = clics dans les pages.
# ACTIONS_VIA=api

# Cartes invendues : après UNSOLD_MAX_TRIES enchères terminées sans acheteur, la carte
# n'est plus mise en vente pendant UNSOLD_COOLDOWN_DAYS jours, puis elle est retentée.
# UNSOLD_MAX_TRIES=3
# UNSOLD_COOLDOWN_DAYS=5

# Ajustement du prix de vente d'après les enchères en cours de la même carte (+/- un
# écart type), jamais sous PRICE_FLOOR_RATIO × prix moyen.
# MARKET_ADJUST=true
# PRICE_FLOOR_RATIO=0.5

# Journal des appels à l'API du site dans state/api.log (sans cookies) : 1 pour l'activer.
# API_TRACE=

# Ressources maximales du conteneur (docker compose).
# CPU_LIMIT=2
# MEM_LIMIT=2g

# Raretés mises en vente (L, UR, SR, R, PC, C), séparées par des virgules. Vide = toutes.
SELL_RARITIES=L,SR

# Optionnel
# BASE_URL=https://www.wiki-masters.com
# SAFE_CARDS_FILE=safed_cards.json
# STATE_DIR=state
# PRICE_RATIO=0.70
# Durée des enchères, libellé exact d'un bouton du site : 10 min, 30 min, 1 h, 3 h, 6 h, 12 h
# AUCTION_DURATION_LABEL=1 h
# Délai avant la passe suivante (ex. 10 min, 1 h, 1h30 ; 5 min minimum).
# Vide = la durée des enchères ci-dessus.
# RUN_INTERVAL=
# HEADLESS=true
# Chemin d'un Chromium déjà installé (inutile dans l'image Docker)
# CHROMIUM_EXECUTABLE=
