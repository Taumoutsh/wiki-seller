# Copier ce fichier en .env (jamais commité). Tous les réglages sont optionnels.

# Bot Telegram : session expirée, bilans, commandes (voir README, « Bot Telegram »).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Minutes d'attente de votre réponse quand la session a expiré.
# TELEGRAM_WAIT=60
# Bilan Telegram toutes les N heures ; 0 = jamais.
# REPORT_HOURS=2

# Session copiée depuis un navigateur connecté, si vous n'utilisez pas le bot (voir README,
# « Connexion »). Format : sb-...-auth-token.0=base64-...; sb-...-auth-token.1=...
# SESSION_COOKIES=

# Raretés mises en vente (L, UR, SR, R, PC, C), séparées par des virgules. Vide = toutes.
SELL_RARITIES=L,SR
# Part du prix moyen utilisée pour la mise de départ.
# PRICE_RATIO=0.70
# Ajustement du prix de vente d'après les enchères en cours de la même carte (+/- un
# écart type), jamais sous PRICE_FLOOR_RATIO × prix moyen.
# MARKET_ADJUST=true
# PRICE_FLOOR_RATIO=0.5
# Durée des enchères : 10m, 30m, 1h, 3h, 6h, 12h
# AUCTION_DURATION_LABEL=1h
# Durée des ventes la nuit, heures de Paris [début-fin[=libellé ; vide = toute la journée
# AUCTION_DURATION_LABEL.
NIGHT_DURATIONS=1-3=12h;3-6=6h
# Délai avant la passe suivante (ex. 10 min, 1 h, 1h30 ; 5 min minimum). Vide = la durée
# des enchères.
# RUN_INTERVAL=
# Cartes invendues : après UNSOLD_MAX_TRIES enchères sans acheteur, mises de côté
# UNSOLD_COOLDOWN_DAYS jours.
# UNSOLD_MAX_TRIES=3
# UNSOLD_COOLDOWN_DAYS=5
# Heures pendant lesquelles un prix moyen lu reste en cache.
# PRICE_CACHE_HOURS=24
# Vente automatique : ventes connues minimales pour se fier au prix d'une carte ; en dessous,
# elle est mise de côté (réglage commun, /set ventes_min).
# MIN_SALES_TO_SELL=4

# Achats (/buy) : budget total optionnel des mises en cours, en wikibidous, et nombre de
# secondes avant la fin d'une enchère pour surenchérir (2 à 300 ; l'enchère est relue
# chaque seconde pendant sa dernière minute).
# MAX_TOTAL_BIDS=
# SNIPE_LEAD=30

# Défausse en arrière-plan : au-delà de DISCARD_TRIGGER exemplaires dans la collection,
# les cartes valant moins de DISCARD_BELOW sont défaussées une à une (jamais les cartes
# protégées, à acheter ou à vendre). DISCARD_BELOW=0 : désactivée.
# DISCARD_BELOW=15
# DISCARD_TRIGGER=150

# Technique
# BASE_URL=https://www.wiki-masters.com
# STATE_DIR=state
# Ressources maximales du conteneur (docker compose).
# CPU_LIMIT=1
# MEM_LIMIT=512m
# Session du site (Supabase) : trouvées toutes seules, à ne régler qu'en cas de problème.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
